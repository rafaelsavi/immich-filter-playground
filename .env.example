# Server settings
PLAYGROUND_HOST=0.0.0.0
PLAYGROUND_PORT=8090

# Immich connection
IMMICH_URL=http://localhost:2283
IMMICH_EXTERNAL_URL=
# IMMICH_INSECURE_SKIP_VERIFY=false
# IMMICH_TIMEOUT_SECONDS=45

# Immich Account(s) (format: name1:key1,name2:key2 or a single key)
IMMICH_ACCOUNTS=alice:your_immich_api_key_here
# Alternatively, define per-account env vars:
# IMMICH_ACCOUNT_ALICE=your_immich_api_key_here
# IMMICH_ACCOUNT_BOB=bob_api_key_here
# (Legacy IMMICH_API_KEY=... is also supported for backward compatibility)

# Default query behavior
PLAYGROUND_SAMPLE_SIZE=24
PLAYGROUND_SEARCH_MODE=random
PLAYGROUND_INCLUDE_VIDEOS=true
PLAYGROUND_INCLUDE_ARCHIVED=false
